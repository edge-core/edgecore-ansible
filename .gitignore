# =============================================================================
# .gitignore for the edgecore.edgecos collection repo
# =============================================================================

# --- Python virtual environments (local, large; never commit) ---
.venv/
.venv-lint/
.python313/

# --- Locally built CPython / toolchain artifacts ---
*.so
*.o

# --- Python bytecode caches ---
__pycache__/
*.py[cod]
*$py.class

# --- Built Ansible collection artifacts (rebuild with `ansible-galaxy collection build`) ---
*.tar.gz

# --- ansible-test working output (collection is at repo root) ---
tests/output/

# --- antsibull-changelog cache ---
changelogs/.plugin-cache.yaml

# --- Ansible runtime noise ---
*.retry
*.log

# --- agent / working dirs ---
.agents/

# --- local teaching-project remnants (never part of the collection; may hold
#     real device secrets/IPs — keep them out of this collection branch) ---
backups/
example-topology/

# --- Editor / OS cruft ---
.vscode/
.idea/
.DS_Store
*.swp
