# =============================================================================
# .gitignore for the edgecore-ansible project
# =============================================================================

# --- Python virtual environments (local, large; never commit) ---
.venv/
.venv-lint/
.python313/

# --- Locally built CPython / toolchain artifacts ---
*.so
*.o

# --- Python bytecode caches ---
__pycache__/
*.py[cod]
*$py.class

# --- Built Ansible collection artifacts (rebuild with `ansible-galaxy collection build`) ---
*.tar.gz
collection/ansible_collections/*/*/tests/output/

# --- ansible-test / internal working artifacts ---
.agents/
tests/output/

# --- Ansible runtime noise ---
*.retry
*.log

# --- Device config backups (contain real device secrets: enable password, IPs) ---
backups/

# --- facts-audit example: collected facts (MAC/ARP JSON+CSV, running-config
#     backups) may contain real device secrets/IPs. Keep the tracked .gitkeep
#     so the directory stays discoverable. ---
examples/facts-audit/output/*
!examples/facts-audit/output/.gitkeep

# --- config-backup example: running-config .cfg backups contain real device
#     secrets/IPs (enable password, SNMP communities). Keep the tracked
#     .gitkeep so the directory stays discoverable. ---
examples/config-backup/output/*
!examples/config-backup/output/.gitkeep

# --- Raw customer device configs (contain real secrets/IPs; keep only derived, sanitized examples) ---
example-topology/

# --- Secrets: never commit real credentials or vault files ---
# The committed inventory uses placeholders; keep any real/vault files out of git.
*_vault.yml
*vault_pass*
.vault_pass
inventory/group_vars/*secret*
inventory/host_vars/*secret*

# --- Editor / OS cruft ---
.vscode/
.idea/
.DS_Store
*.swp
